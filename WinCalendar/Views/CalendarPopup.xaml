<Window x:Class="WinCalendar.Views.CalendarPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CalendarPopup" Width="400" Height="490"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- ================= 全局资源 ================= -->
    <Window.Resources>

        <!-- 🎯 全局统一圆角：想整体调圆润度，只改这一处（月/年按钮、今天、▲▼、日期格都会跟着变） -->
        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>

        <!--
            圆角按钮基类。
            ⚠️ 关键在【替换掉 ControlTemplate】：WPF 默认模板用的是系统主题里的 ButtonChrome，
               它会自己画一套矩形高亮/hover 淡蓝底（就是你在截图里看到的方形框），
               而且完全无视 Background="Transparent"。只有换掉模板，圆角才真正生效。
        -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <!-- 干掉"今天"和标题上那个虚线焦点框 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20808080"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#40808080"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 选中态（当前月份 / 当前年份）：实心强调色底 + 反色字，hover 时提亮 -->
        <Style x:Key="RoundedSelectedButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TodayTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>   <!-- 用不透明度做 hover，两套主题都不跑偏 -->
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 外层 Border 负责两件事：① 背景（系统材质 / 模糊图 / 主题兜底色，由代码切换）
                                    ② 用圆角把内容裁好 -->
    <Border x:Name="RootBorder" Background="{DynamicResource WindowBackgroundBrush}"
            CornerRadius="12" Margin="0">
        <Grid>
            <!-- 说明：XAML 规定属性元素（RowDefinitions）必须写在所有子元素之前，所以它排最上面 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

                                                                
            
            <!-- 🎯 唯一的一层"背景层"：三种情况下装不同东西，但永远只有这一层 ——
                   ① 系统材质生效 → 半透明主题蒙版；② 材质失效 → 不透明兜底色；③ 老系统 → 抓屏快照

                 ⚠️ 必须收敛成一层，因为它要**跟着内容一起淡入**。
                    实测教训：兜底底色曾挂在 RootBorder.Background 上 —— 那一层不参与淡入，
                    于是开屏第一帧会先冒出一块"空白的实心面板"，然后才轮到内容出现。 -->
            <Border x:Name="BackdropLayer" Grid.RowSpan="2"
                    Background="{DynamicResource MaterialTintBrush}"
                    Visibility="Collapsed"/>

                                                               
                                      
            <!-- ================= 固定头部 ================= -->
            <Grid x:Name="HeaderPanel" Margin="20,20,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="TxtCurrentTime" Text="15:44:10" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="TxtCurrentDate" Text="10月8日，星期四" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtCurrentLunar" Text="乙巳年八月廿九" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"/>

                    <Button x:Name="BtnViewTitle" Click="BtnViewTitle_Click" Style="{StaticResource RoundedButtonStyle}" Padding="4,2" Margin="0,18,0,0" HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtViewTitle" Text="2026年10月" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Button>
                </StackPanel>

                <!-- 右侧：上面是主题切换按钮，下面是"今天 / ▲ / ▼" -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 右上角竖排：主题切换 + 接管开关 -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Right">
                        <Button x:Name="BtnTheme" Click="BtnTheme_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Width="30" Height="30" HorizontalAlignment="Right"
                                ToolTip="切换深色 / 浅色">
                            <TextBlock x:Name="TxtThemeIcon" Text="&#xE708;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource SubTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- ⚙️ 接管开关：实心齿轮 = 接管中（弹我们的日历）；空心齿轮 = 已交还 Windows -->
                        <Button x:Name="BtnSettings" Click="BtnSettings_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Width="30" Height="30" HorizontalAlignment="Right" Margin="0,4,0,0"
                                ToolTip="接管系统时钟日历">
                            <TextBlock x:Name="TxtSettingsIcon" Text="&#xE115;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,2">
                        <Button x:Name="BtnToday" Content="今天" Click="Today_Click" Style="{StaticResource RoundedButtonStyle}" Foreground="{DynamicResource AccentBrush}" FontSize="14" Margin="0,0,5,0" Padding="8,3"/>
                        <Button x:Name="BtnPrev" Click="BtnPrev_Click" Style="{StaticResource RoundedButtonStyle}" Width="30" Height="30">
                            <TextBlock Text="▲" FontSize="14" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnNext" Click="BtnNext_Click" Style="{StaticResource RoundedButtonStyle}" Width="30" Height="30">
                            <TextBlock Text="▼" FontSize="14" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ================= 内容视图区 ================= -->
            <!-- ClipToBounds="True"：整页翻动 / 胶片溢出都靠它裁掉，不会遮挡头部 -->
            <Grid x:Name="ViewHost" Grid.Row="1" ClipToBounds="True">

                <!-- 视图1：主日历视图 -->
                <!-- RenderTransformOrigin="0.5,0.5"：缩放以自身中心为原点，才会"从中心扩散" -->
                <Grid x:Name="Grid_MainCalendar" Margin="20,0,20,20" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <!-- 👈 视图切换的缩放只作用在这一层；日期滚动的位移在内层 ItemsControl 上，互不干扰 -->
                        <ScaleTransform x:Name="MainScale"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 星期表头：永远固定，不参与任何位移动画 -->
                    <UniformGrid Grid.Row="0" Columns="7" Margin="0,0,0,5">
                        <TextBlock Text="一" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,0,0,5"/>
                        <TextBlock Text="二" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,0,0,5"/>
                        <TextBlock Text="三" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,0,0,5"/>
                        <TextBlock Text="四" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,0,0,5"/>
                        <TextBlock Text="五" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,0,0,5"/>
                        <TextBlock Text="六" HorizontalAlignment="Center" Foreground="{DynamicResource WeekendTextBrush}" FontSize="12" Margin="0,0,0,5"/>
                        <TextBlock Text="日" HorizontalAlignment="Center" Foreground="{DynamicResource WeekendTextBrush}" FontSize="12" Margin="0,0,0,5"/>
                    </UniformGrid>

                    <!-- 👇 日期视口：只有 6 行的高度，第 7 行（缓冲胶片）被裁在下面看不见 -->
                    <Grid x:Name="CalendarViewport" Grid.Row="1" ClipToBounds="True"
                          SizeChanged="CalendarViewport_SizeChanged">

                        <!-- 👇 位移动画只作用在"日期区"，所以星期表头不会跟着抖 -->
                        <ItemsControl x:Name="CalendarItems" VerticalAlignment="Top">
                            <ItemsControl.RenderTransform>
                                <TranslateTransform x:Name="MainTranslate"/>
                            </ItemsControl.RenderTransform>

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 渲染 7 行，但只有 6 行可见 -->
                                    <UniformGrid Columns="7" Rows="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="DayItem_Click" Tag="{Binding}" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="HoverBorder" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlCornerRadius}" Margin="3">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="HoverBorder" Property="Background" Value="#20808080"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="HoverBorder" Property="Background" Value="#40808080"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>

                                        <Grid Width="44" Height="44">
                                            <Border CornerRadius="{StaticResource ControlCornerRadius}" Margin="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HolidayBackgroundBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsWorkday}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource WorkdayBackgroundBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <Border CornerRadius="{StaticResource ControlCornerRadius}" Margin="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource TodayBackgroundBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <Border CornerRadius="{StaticResource ControlCornerRadius}" BorderThickness="1.5" Margin="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DayNumber}" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TodayTextBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WeekendTextBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WeekendTextBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource OtherMonthTextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding LunarDate}" HorizontalAlignment="Center" FontSize="10.5" Margin="0,-1,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TodayTextBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.7"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                                                    Background="{DynamicResource RestBadgeBrush}" CornerRadius="7" Width="14" Height="14">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="休" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                                                    Background="{DynamicResource WorkBadgeBrush}" CornerRadius="7" Width="14" Height="14">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWorkday}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="班" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>

                <!-- 视图2：月份选择视图 -->
                <Grid x:Name="Grid_MonthSelect" Margin="20,0,20,20" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <!-- ⚠️ 顺序不能反：先缩放、后位移，整页翻动的位移量才不会被缩放系数二次放大 -->
                        <TransformGroup>
                            <ScaleTransform x:Name="MonthScale"/>
                            <TranslateTransform x:Name="MonthTranslate"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <UniformGrid x:Name="MonthItemsGrid" Columns="3" Rows="4" Margin="0,10,0,0"/>
                </Grid>

                <!-- 视图3：年份选择视图 -->
                <Grid x:Name="Grid_YearSelect" Margin="20,0,20,20" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="YearScale"/>
                            <TranslateTransform x:Name="YearTranslate"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <!-- ⚠️ Columns × Rows 必须等于代码里的 YearsPerPage(20)，改动请两头一起改 -->
                    <UniformGrid x:Name="YearItemsGrid" Columns="4" Rows="5" Margin="0,10,0,0"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
