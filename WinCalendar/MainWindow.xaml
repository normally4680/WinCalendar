<Window x:Class="WinCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="WinCalendar" Width="1" Height="1"
        ShowInTaskbar="False" 
        WindowStyle="None"
        AllowsTransparency="True" 
        Opacity="0" 
        Background="Transparent">
    <Grid>
        <!-- 这里恢复 LeftClickCommand，但先去掉了 Binding -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="我的托盘日历"
                        LeftClickCommand="{Binding ShowCalendarCommand}"
                        IconSource="pack://application:,,,/app.ico">
            <tb:TaskbarIcon.ContextMenu>
                <!-- 用主题里的样式而不是系统默认样式：系统默认恒为浅色，深色主题下会非常突兀 -->
                <ContextMenu Style="{DynamicResource ThemedContextMenu}">
                    <MenuItem Header="退出" Click="MenuItem_Click" Style="{DynamicResource ThemedMenuItem}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>