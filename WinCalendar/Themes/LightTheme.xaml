<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== 背景 / 材质 ===================== -->

    <!-- 兜底底色：系统材质不可用、抓屏也失败时就是它 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E6FFFFFF"/>

    <!-- 回退路径（老系统）的模糊图之上烤进去的那层蒙版。
         想更像玻璃就把 CC 调小（99 = 60%），想更实就把 CC 调大（E6 = 90%）。 -->
    <SolidColorBrush x:Key="BackdropTintBrush" Color="#CCFFFFFF"/>

    <!-- 🎯 系统材质（Win11 Acrylic）之上再叠的一层主题色蒙版。
         材质本身太透明，文字对比度不够，必须再加一层 tint 才能看清。
         口诀：文字要更清楚 → 99 调大（B3 / CC）；要更透更"玻璃" → 调小（66 / 80）。 -->
    <SolidColorBrush x:Key="MaterialTintBrush" Color="#99FFFFFF"/>

    <!-- ===================== 文字 ===================== -->

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#333333"/>
    <!-- 农历小字 / 星期表头。太淡在半透明背景上会看不见，所以比常规"次要文字"更深一档 -->
    <SolidColorBrush x:Key="SubTextBrush" Color="#767676"/>
    <SolidColorBrush x:Key="WeekendTextBrush" Color="#1E90FF"/>
    <!-- 上/下个月的日期：要比本月淡，但不能淡到看不见 -->
    <SolidColorBrush x:Key="OtherMonthTextBrush" Color="#A6A6A6"/>

    <!-- ===================== 强调色 / 状态色 ===================== -->

    <!-- 今天的底色、选中框、今天按钮……统一走这个键，两套主题各自调 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1E90FF"/>
    <SolidColorBrush x:Key="TodayBackgroundBrush" Color="#1E90FF"/>
    <SolidColorBrush x:Key="TodayTextBrush" Color="White"/>

    <!-- 节假日"休"角标 / 调休"班"角标 -->
    <SolidColorBrush x:Key="RestBadgeBrush" Color="#1E90FF"/>
    <SolidColorBrush x:Key="WorkBadgeBrush" Color="#FF8C00"/>
    <SolidColorBrush x:Key="HolidayBackgroundBrush" Color="#E6F0FF"/>
    <SolidColorBrush x:Key="WorkdayBackgroundBrush" Color="#F0F0F0"/>

    <!-- ===================== 托盘右键菜单 ===================== -->
    <!-- 系统默认的菜单样式恒为浅色，深色主题下会非常突兀，所以自绘一套 -->

    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#E2E2E2"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#1A000000"/>

    <Style x:Key="ThemedContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="4" Margin="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.22" Color="Black"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
